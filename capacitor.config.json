{
  "appId": "app.lesefreund.reader",
  "appName": "Lesefreund",
  "webDir": "app",
  "backgroundColor": "#fbf8f3",
  "android": { "allowMixedContent": false },
  "ios": { "contentInset": "never" },
  "plugins": {
    "CapacitorHttp": { "enabled": true },
    "SplashScreen": { "launchShowDuration": 600, "backgroundColor": "#fdf5e8", "showSpinner": false },
    "StatusBar": { "overlaysWebView": false }
  }
}
