# Скопируй этот файл в .env и вставь СВОЙ токен от @BotFather.
# Файл .env в git не попадёт (см. .gitignore). Никогда не публикуй токен!
BOT_TOKEN=paste-your-token-from-botfather-here

# ID админа бота (кому доступна админ-панель по слову «админ»). Узнать: @userinfobot.
# Если не задать — используется ID владельца из кода. Своё значение приоритетнее.
ADMIN_ID=

# (необязательно) URL мини-аппа (Web App), например https://username.github.io/NoviiProekt/
# Если задан — в ЛС появится кнопка «🎮 Открыть LazyGame» и кнопка-меню.
WEBAPP_URL=
